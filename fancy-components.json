		{
			"name": "animated-gradient-svg",
			"type": "registry:block",
			"title": "Animated Gradient Svg",
			"author": "SikandarJODD",
			"description": "An animated SVG gradient background built from moving blurred circles.",
			"files": [
				{
					"path": "./src/lib/components/fancy/animated-gradient-svg/animated-gradient-svg.svelte",
					"type": "registry:component",
					"target": "fancy/animated-gradient-svg/animated-gradient-svg.svelte"
				},
				{
					"path": "./src/lib/components/fancy/animated-gradient-svg/index.ts",
					"type": "registry:file",
					"target": "fancy/animated-gradient-svg/index.ts"
				},
				{
					"type": "registry:hook",
					"path": "./src/lib/hooks/use-dimension.svelte.ts"
				}
			],
			"registryDependencies": [],
			"cssVars": {
				"theme": {
					"animate-background-gradient": "background-gradient"
				}
			},
			"css": {
				"@keyframes background-gradient": {
					"0%, 100%": {
						"transform": "translate(0, 0)",
						"animationDelay": "var(--background-gradient-delay, 0s)"
					},
					"20%": {
						"transform": "translate(calc(100% * var(--tx-1, 1)), calc(100% * var(--ty-1, 1)))"
					},
					"40%": {
						"transform": "translate(calc(100% * var(--tx-2, -1)), calc(100% * var(--ty-2, 1)))"
					},
					"60%": {
						"transform": "translate(calc(100% * var(--tx-3, 1)), calc(100% * var(--ty-3, -1)))"
					},
					"80%": {
						"transform": "translate(calc(100% * var(--tx-4, -1)), calc(100% * var(--ty-4, -1)))"
					}
				}
			}
		},
