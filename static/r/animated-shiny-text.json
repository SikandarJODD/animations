{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "animated-shiny-text",
	"title": "Animated Shiny Text",
	"type": "registry:block",
	"description": "A shimmering text effect component that creates a moving shine animation across text.",
	"meta": {
		"categories": [
			"text",
			"shimmer",
			"marketing",
			"automatic",
			"subtle"
		]
	},
	"css": {
		"@keyframes shiny-text": {
			"0%, 90%, 100%": {
				"background-position": "calc(-100% - var(--shiny-width)) 0"
			},
			"30%, 60%": {
				"background-position": "calc(100% + var(--shiny-width)) 0"
			}
		}
	},
	"cssVars": {
		"theme": {
			"animate-shiny-text": "shiny-text 8s infinite"
		}
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport type { ClassValue } from \"svelte/elements\";\n\timport { cn } from \"#lib/utils.js\";\n\tinterface Props {\n\t\tchildren?: import(\"svelte\").Snippet;\n\t\tclass?: ClassValue;\n\t\tshimmerWidth?: number;\n\t\tduration?: number;\n\t\t[key: string]: any;\n\t}\n\n\tlet {\n\t\tchildren,\n\t\tclass: className,\n\t\tshimmerWidth = 100,\n\t\tduration = 8,\n\t\t...restProps\n\t}: Props = $props();\n</script>\n\n<span\n\tstyle=\"--shiny-width: {shimmerWidth}px; --duration: {duration}s\"\n\tclass={cn(\n\t\t\"shiny-text inline-block text-neutral-600 dark:text-neutral-400\",\n\t\t\"animate-shiny-text bg-clip-text bg-no-repeat [-webkit-text-fill-color:transparent] motion-reduce:animate-none\",\n\t\t\"[--shiny-highlight:var(--color-neutral-950)] dark:[--shiny-highlight:var(--color-white)]\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{@render children?.()}\n</span>\n\n<style>\n\t.shiny-text {\n\t\tbackground-image:\n\t\t\tlinear-gradient(110deg, transparent 20%, var(--shiny-highlight) 50%, transparent 80%),\n\t\t\tlinear-gradient(currentColor, currentColor);\n\t\tbackground-size:\n\t\t\tvar(--shiny-width) 100%,\n\t\t\t100% 100%;\n\t\tbackground-position:\n\t\t\tcalc(-100% - var(--shiny-width)) 0,\n\t\t\t0 0;\n\t}\n</style>\n",
			"type": "registry:component",
			"target": "magic/animated-shiny-text/animated-shiny-text.svelte"
		}
	]
}