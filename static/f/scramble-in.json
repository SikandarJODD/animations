{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "scramble-in",
	"title": "Scramble In",
	"type": "registry:block",
	"author": "SikandarJODD",
	"description": "Animate text in by revealing real characters through a configurable scramble pass.",
