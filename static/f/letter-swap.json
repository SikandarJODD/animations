{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "letter-swap",
	"title": "Letter Swap",
	"type": "registry:block",
	"author": "SikandarJODD",
	"description": "Slide each letter into a second copy on hover with directional staggered motion.",
	"dependencies": [
		"motion-sv"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport { motion, useAnimate, stagger, type AnimationOptions } from \"motion-sv\";\n\timport { cn } from \"$UTILS$\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\tinterface LetterSwapProps extends HTMLAttributes<HTMLSpanElement> {\n\t\tlabel: string;\n\t\treverse?: boolean;\n\t\ttransition?: AnimationOptions;\n\t\tstaggerDuration?: number;\n\t\tstaggerFrom?: \"first\" | \"last\" | \"center\" | number;\n\t\tclass?: string;\n\t}\n\n\tlet {\n\t\tlabel,\n\t\treverse = true,\n\t\ttransition = {\n\t\t\ttype: \"spring\",\n\t\t\tduration: 0.7,\n\t\t},\n\t\tstaggerDuration = 0.03,\n\t\tstaggerFrom = \"first\",\n\t\tclass: className,\n\t\tonclick,\n\t\t...props\n\t}: LetterSwapProps = $props();\n\n\tlet [scope, animate] = useAnimate();\n\tlet blocked = $state(false);\n\tlet letters = $derived(label.split(\"\"));\n\n\tlet hoverStart = () => {\n\t\tif (blocked) return;\n\t\tblocked = true;\n\n\t\t// Function to merge user transition with stagger and delay\n\t\tlet mergeTransition = (baseTransition: AnimationOptions) => ({\n\t\t\t...baseTransition,\n\t\t\tdelay: stagger(staggerDuration, {\n\t\t\t\tfrom: staggerFrom,\n\t\t\t}),\n\t\t});\n\n\t\tanimate(\n\t\t\t\".letter\",\n\t\t\t{ y: reverse ? \"100%\" : \"-100%\" },\n\t\t\tmergeTransition(transition) as any\n\t\t).then(() => {\n\t\t\tanimate(\n\t\t\t\t\".letter\",\n\t\t\t\t{\n\t\t\t\t\ty: 0,\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\tduration: 0,\n\t\t\t\t}\n\t\t\t).then(() => {\n\t\t\t\tblocked = false;\n\t\t\t});\n\t\t});\n\n\t\tanimate(\n\t\t\t\".letter-secondary\",\n\t\t\t{\n\t\t\t\ttop: \"0%\",\n\t\t\t},\n\t\t\tmergeTransition(transition) as any\n\t\t).then(() => {\n\t\t\tanimate(\n\t\t\t\t\".letter-secondary\",\n\t\t\t\t{\n\t\t\t\t\ttop: reverse ? \"-100%\" : \"100%\",\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\tduration: 0,\n\t\t\t\t}\n\t\t\t);\n\t\t});\n\t};\n</script>\n\n<span\n\tbind:this={scope.current}\n\tclass={cn(\"relative flex items-center justify-center overflow-hidden\", className)}\n\tonmouseenter={hoverStart}\n\t{onclick}\n\t{...props}\n>\n\t<span class=\"sr-only\">{label}</span>\n\n\t{#each letters as letter}\n\t\t<span class=\"relative flex whitespace-pre\" aria-hidden=\"true\">\n\t\t\t<motion.span class=\"letter relative\" style={{ top: 0 }}>\n\t\t\t\t{letter}\n\t\t\t</motion.span>\n\t\t\t<motion.span\n\t\t\t\tclass=\"letter-secondary absolute\"\n\t\t\t\tstyle={{ top: reverse ? \"-100%\" : \"100%\" }}\n\t\t\t>\n\t\t\t\t{letter}\n\t\t\t</motion.span>\n\t\t</span>\n\t{/each}\n</span>\n",
			"type": "registry:component",
			"target": "fancy/letter-swap/letter-swap.svelte"
		},
		{
			"content": "export { default as LetterSwap } from \"./letter-swap.svelte\";\n",
			"type": "registry:file",
			"target": "fancy/letter-swap/index.ts"
		}
	]
}