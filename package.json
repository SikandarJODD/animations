		"@shikijs/themes": "^3.21.0",
		"cn": "^0.4.0",
		"cobe": "^2.0.1",
		"gsap": "^3.15.0",
		"isomorphic-dompurify": "2.25.0",
		"lenis": "^1.3.23",
		"mode-watcher": "^1.1.0",
		"motion-sv": "^0.1.12",
		"opentype.js": "^1.3.4",
		"package-manager-detector": "^1.6.0",
		"piri": "^1.3.2",
		"qrcode": "^1.5.4",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^3.21.0",
		"spotify-url-info": "^3.3.0",
		"sv-agentation": "^0.4.0",
		"svelte-meta-tags": "^5.0.2",
		"svelte-sonner": "^1.0.7",
		"svelte-toolbelt": "^0.10.6"
