{
	"name": "sv5-animations",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"author": {
		"name": "SikandarJODD"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:blocks": "pnpm shadcn-svelte registry build",
		"build:spell": "pnpm shadcn-svelte registry build ./spell-registry.json -o ./static/s",
		"build:fancy": "pnpm shadcn-svelte registry build ./fancy-components.json -o ./static/f",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/opentype.js": "^1.3.9",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@neoconfetti/svelte": "^2.2.2",
		"@shikijs/langs": "^3.21.0",
		"@shikijs/themes": "^3.21.0",
		"isomorphic-dompurify": "2.25.0",
		"lenis": "^1.3.23",
		"mode-watcher": "^1.1.0",
		"motion-sv": "^0.1.12",
		"opentype.js": "^1.3.4",
		"package-manager-detector": "^1.6.0",
		"piri": "^1.3.2",
		"qrcode": "^1.5.4",
		"runed": "^0.37.1",
