{
	"name": "sv5-animations",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"author": {
		"name": "SikandarJODD"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"create:route": "node scripts/create-route.js",
		"create:routes": "node scripts/create-routes.js",
		"docs:components": "node scripts/generate-magic-docs.js",
		"docs:magic": "node scripts/generate-magic-docs.js",
		"docs:spell": "node scripts/generate-magic-docs.js --group spell",
		"docs:fancy": "node scripts/generate-magic-docs.js --group fancy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"magic:blocks": "pnpm shadcn-svelte registry build",
		"spell:blocks": "pnpm shadcn-svelte registry build ./spell-registry.json -o ./static/s",
		"build:fancy": "pnpm shadcn-svelte registry build ./fancy-components.json -o ./static/f",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/opentype.js": "^1.3.9",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.1"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/shantell-sans": "^5.3.0",
		"@neoconfetti/svelte": "^2.2.2",
